{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES2015",
    "outDir": "./static/js",
    "rootDir": "./static/ts",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "lib": ["DOM", "ES2015", "ES2016", "ES2017"]
  },
  "include": ["static/ts/**/*.ts"],
  "exclude": ["node_modules"]
}
